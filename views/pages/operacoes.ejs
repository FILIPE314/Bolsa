<div class="container animate-fade-in" style="margin-top: 100px; margin-bottom: 100px;">
  <% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show animate-fade-in" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show animate-fade-in" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <div class="card shadow">
    <div class="card-body">
      <h3 class="card-title mb-4 text-center">Minhas Operações</h3>
      <form class="row g-3 mb-4 justify-content-center align-items-end text-center" style="max-width:900px;margin:auto;" method="get" action="/operacoes/ativo/" onsubmit="this.action += this.ativo.value;">
        <div class="col-md-3 col-12">
          <input type="text" class="form-control" name="ativo" placeholder="Código do ativo" pattern="[A-Z]{4}\d{1,2}">
        </div>
        <div class="col-md-3 col-12 mb-2">
          <select class="form-select" name="tipoDeOperacao">
            <option value="">Tipo de operação</option>
            <option value="compra">Compra</option>
            <option value="venda">Venda</option>
          </select>
        </div>
        <div class="col-md-2 col-6">
          <label for="dataInicio" class="form-label small">Data inicial</label>
          <input type="date" class="form-control" id="dataInicio" name="dataInicio">
        </div>
        <div class="col-md-2 col-6">
          <label for="dataFim" class="form-label small">Data final</label>
          <input type="date" class="form-control" id="dataFim" name="dataFim">
        </div>
        <div class="col-md-2 col-12 d-flex gap-2 justify-content-center align-items-end mb-2">
          <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
          <a href="/operacoes" class="btn btn-outline-secondary w-100">Limpar</a>
        </div>
      </form>
      <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle text-center">
          <thead class="table-primary">
            <tr>
              <th>Data</th>
              <th>Tipo de operação</th>
              <th>Código do ativo</th>
              <th>Quantidade</th>
              <th>Preço unitário</th>
              <th>Valor Bruto</th>
              <th>Taxa B3</th>
              <th>Valor Líquido</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < operacoes.length; i++) { %>
              <% const operacao = operacoes[i]; %>
              <tr>
                <td><%= operacao.data ? new Date(operacao.data).toLocaleDateString('pt-BR') : '' %></td>
                <td class="text-capitalize"><%= operacao.tipoDeOperacao %></td>
                <td>
                  <% if (/^[A-Z]{4}\d{1,2}$/.test(operacao.ativo)) { %>
                    <span class="badge bg-success"><%= operacao.ativo %></span>
                  <% } else { %>
                    <span class="badge bg-danger"><%= operacao.ativo %></span>
                  <% } %>
                </td>
                <td><%= operacao.quantidade %></td>
                <td>R$ <%= Number(operacao.preco).toFixed(2) %></td>
                <td>R$ <%= Number(operacao.valorBruto).toFixed(2) %></td>
                <td>R$ <%= Number(operacao.taxaB3).toFixed(2) %></td>
                <td>R$ <%= Number(operacao.valorLiquido).toFixed(2) %></td>
                <td>
                  <a href="/operacoes/<%= operacao.id %>/editar" class="btn btn-sm btn-warning animate-bounce">Editar</a>
                  <form action="/operacoes/<%= operacao.id %>/excluir" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir esta operação?');">
                    <button type="submit" class="btn btn-sm btn-danger animate-bounce">Excluir</button>
                  </form>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="text-end mt-3">
        <a class="btn btn-success animate-bounce" href="/nova_operacao">Cadastrar nova operação</a>
      </div>
    </div>
  </div>
</div>
<style>
.animate-fade-in { animation: fadeIn 1.2s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
.animate-bounce { transition: transform 0.2s; }
.animate-bounce:hover { transform: translateY(-4px) scale(1.04); }
</style>