<div class="container mt-5 animate-fade-in" style="margin-top: 60px; margin-bottom: 60px;">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow">
        <div class="card-body">
          <h3 class="card-title text-center mb-4">Registro</h3>
          <form action="/register" method="POST">
            <div class="mb-3">
              <label for="inputNome" class="form-label">Nome</label>
              <input type="text" class="form-control" name="nome" id="inputNome" required>
            </div>
            <div class="mb-3">
              <label for="inputEmail" class="form-label">E-mail</label>
              <input type="email" class="form-control" name="email" id="inputEmail" required>
            </div>
            <div class="mb-3">
              <label for="inputSenha" class="form-label">Senha</label>
              <input type="password" class="form-control" name="senha" id="inputSenha" required>
            </div>
            <button type="submit" class="btn btn-success w-100 animate-bounce">Registrar</button>
          </form>
          <div class="mt-3 text-center">
            <span>Já tem uma conta? <a href="/login">Entrar</a></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
.animate-fade-in { animation: fadeIn 1.2s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
.animate-bounce { transition: transform 0.2s; }
.animate-bounce:hover { transform: translateY(-4px) scale(1.04); }
</style>